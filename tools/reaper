#!/usr/bin/env python3
"""Drive REAPER through the rotator loader's file bridge.

usage: tools/reaper ping | reload | dump | action <id> | lua <file|-> | build-reload
env:   REAPER_BRIDGE_TIMEOUT (seconds, default 10)
"""
import os
import subprocess
import sys
import time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
BRIDGE = os.path.join(ROOT, ".bridge")


def send(command):
    os.makedirs(BRIDGE, exist_ok=True)
    seq = str(time.time_ns())
    cmd = os.path.join(BRIDGE, f"cmd-{seq}.txt")
    res = os.path.join(BRIDGE, f"res-{seq}.txt")
    with open(cmd + ".tmp", "w") as f:
        f.write(command)
    os.rename(cmd + ".tmp", cmd)
    deadline = time.time() + float(os.environ.get("REAPER_BRIDGE_TIMEOUT", "10"))
    while not os.path.exists(res):
        if time.time() > deadline:
            try:
                os.remove(cmd)
            except OSError:
                pass
            sys.exit("timeout: no response from REAPER (is it running, with the rotator loader installed and loaded?)")
        time.sleep(0.05)
    with open(res) as f:
        text = f.read()
    os.remove(res)
    status, _, out = text.partition("\n")
    sys.stdout.write(out)
    if status != "ok":
        sys.exit(status)


def main(args):
    if not args:
        sys.exit(__doc__.strip())
    cmd = args[0]
    if cmd in ("ping", "reload", "dump") and len(args) == 1:
        send(cmd)
    elif cmd == "action" and len(args) == 2:
        send(f"action {args[1]}")
    elif cmd == "lua" and len(args) == 2:
        src = sys.stdin.read() if args[1] == "-" else open(args[1]).read()
        send("lua\n" + src)
    elif cmd == "build-reload" and len(args) == 1:
        if subprocess.call(["cmake", "--build", os.path.join(ROOT, "build")]):
            sys.exit("build failed")
        send("reload")
    else:
        sys.exit(__doc__.strip())


main(sys.argv[1:])
