#!/bin/sh
# Build the release plugin, publish it as a GitHub release and point index.xml (ReaPack) at it.
# usage: tools/release <version>      e.g. tools/release 0.1.0
set -e
v=${1:?usage: tools/release <version>}
cd "$(dirname "$0")/.."
repo=$(gh repo view --json nameWithOwner -q .nameWithOwner)
cmake -S . -B build-release -G Ninja -DROTATOR_DEV=OFF -DCMAKE_BUILD_TYPE=Release
cmake --build build-release --target reaper_rotator
url="https://github.com/$repo/releases/download/v$v/reaper_rotator.dylib"
time=$(date -u +%Y-%m-%dT%H:%M:%SZ)
cat > index.xml <<EOF
<?xml version="1.0" encoding="utf-8"?>
<index version="1" name="Rotator">
  <category name="Extensions">
    <reapack name="reaper_rotator.ext" type="extension" desc="Rotator">
      <metadata>
        <description><![CDATA[Pattern/arrange MIDI sequencer with an Atari ST look. Needs ReaImGui.]]></description>
        <link rel="website">https://github.com/$repo</link>
      </metadata>
      <version name="$v" author="$(gh api user -q .login)" time="$time">
        <source platform="darwin" file="reaper_rotator.dylib">$url</source>
      </version>
    </reapack>
  </category>
</index>
EOF
git add index.xml
git commit -m "Release $v"
git tag "v$v"
git push origin HEAD "v$v"
gh release create "v$v" build-release/reaper_rotator.dylib --title "Rotator $v" --notes "macOS universal (Apple Silicon + Intel). Needs ReaImGui."
